# Copy this file to .env (in the same folder as this file) and fill in real values. Never commit .env.

# Portkey API key used for all model calls (OpenAI via Portkey)
PORTKEY_API_KEY=your-portkey-api-key-here

# Model routed through Portkey
PORTKEY_MODEL=gpt-5.6-terra

# Long random string that signs login cookies, e.g. output of:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string
